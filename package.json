{
  "name": "invariant-writer",
  "version": "0.2.1",
  "private": true,
  "description": "Private, intrinsically intelligent writing feedback powered by local Leanlets.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:lexicon": "node scripts/build-lexicon.mjs",
    "dev": "npm run prepare:lexicon && vite",
    "build": "npm run prepare:lexicon && vite build && node scripts/static-routes.mjs",
    "start": "vite preview --outDir dist/client",
    "check": "tsc --noEmit",
    "lint": "oxlint app lib tests",
    "test": "npm run prepare:lexicon && node --experimental-strip-types --test tests/*.test.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "dictionary-en": "^4.0.0",
    "eld": "^2.1.0",
    "leanlet-ai": "0.3.0-beta.2",
    "lucide-react": "1.31.0",
    "nspell": "^2.1.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wordnet-db": "^3.1.14"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module"
}
